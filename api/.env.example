# Lokalnie (baza z docker-compose.dev.yml wystawiona na localhost:5433)
DATABASE_URL="postgresql://quiz:quiz@localhost:5433/quiz?schema=public"
PORT=4000

# Sekret do podpisywania tokenów logowania (min. 32 znaki).
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-sekret-zmien-mnie-na-produkcji-0123456789abcdef"

# Ciasteczko tylko po HTTPS (na produkcji true, lokalnie po http false)
COOKIE_SECURE=false

# Adres strony — używany w linkach w e-mailach (potwierdzenie konta)
APP_URL=http://localhost:3000

# Poczta (SMTP). Lokalnie: Mailpit z docker-compose.dev.yml, podgląd na http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="maturazinformatyki.it <no-reply@maturazinformatyki.it>"
