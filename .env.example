# Skopiuj do .env (obok docker-compose.yml) i ustaw własne hasło
POSTGRES_USER=quiz
POSTGRES_PASSWORD=zmien-mnie-na-dlugie-haslo
POSTGRES_DB=quiz

# Sekret do podpisywania sesji logowania (min. 32 znaki). Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Zmiana sekretu wyloguje wszystkich użytkowników.
JWT_SECRET=wygeneruj-dlugi-losowy-ciag-znakow

# Adres strony — używany w linkach w e-mailach
APP_URL=https://maturazinformatyki.it

# Poczta (SMTP) — potwierdzenia kont, kody logowania, powiadomienia o kursach.
# Dane z panelu Twojego hostingu poczty (np. home.pl, OVH, Zoho, Gmail z hasłem aplikacji).
#   port 587 + SMTP_SECURE=false  -> STARTTLS (najczęściej)
#   port 465 + SMTP_SECURE=true   -> SSL
SMTP_HOST=smtp.twoj-serwer-poczty.pl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@maturazinformatyki.it
SMTP_PASS=haslo-do-skrzynki
MAIL_FROM="maturazinformatyki.it <no-reply@maturazinformatyki.it>"
